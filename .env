# =============================================================
# Content Studio – Environment Variables
# =============================================================
# These are build-time env vars (Vite exposes VITE_* to the client).
# Copy this file to .env.local and fill in real values there.
# .env.local is git-ignored and NEVER committed.
# =============================================================

# --- n8n webhook URLs (optional) ---
# Leave blank to run in standalone / offline mode.
VITE_IDEA_GENERATION_WEBHOOK_URL=
VITE_POST_PUBLISH_WEBHOOK_URL=

# --- App metadata ---
VITE_APP_VERSION=1.0.0
